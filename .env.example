# ─────────────────────────────────────────────────────────────
# 柚子 yuzu 环境变量示例。复制为 .env 后按实际情况修改。
# .env 含密码，已被 .gitignore 排除，切勿提交到 GitHub。
# ─────────────────────────────────────────────────────────────

# 运行环境：development（本地开发）| trial（试用）| production（正式）
APP_ENV=trial

# 实例标识，登录页与导航栏常显：prod（正式服）| shadow（影子运行·不作数）| test（测试服·不作数）| demo（演示·不作数）
# 影子库、测试服演练库与正式服都是 APP_ENV=production，只能靠它区分；production 不设置时页面显示「未设置实例标识」
# YUZU_INSTANCE=prod

# 浏览器访问端口（Mac mini 上用 http://<Mac mini 局域网 IP>:8080 访问）。只写端口时开在所有网卡上，门店局域网这样用；
# 写成「地址:端口」只开在这个地址上：云服务器上写 127.0.0.1:8080（只给本机的 Caddy）或 <本机的 Tailscale 地址>:8080
# （Docker 发布的端口会绕过主机防火墙，不能只靠 ufw 挡；看门狗按同一个地址做健康检查；8.0.0，docs/RELEASE_V800.md）
APP_PORT=8080

# 外网正式服经反向代理（Caddy）走 HTTPS 时：登录 Cookie 加 Secure；信任代理转来的来源 IP 与 https（逗号分隔、可写网段）。
# TRUST_PROXY 填应用容器里看到的代理地址：Caddy 在同一台主机、经发布的端口连进来时是 Docker 网络的网关，不是 127.0.0.1——
#   docker network inspect <项目名>_default -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# COOKIE_SECURE=true
# TRUST_PROXY=172.18.0.1

# 同机运行多个环境时，项目名、应用端口、备份目录应各自独立。
# 镜像标签默认包含 Compose 项目名；也可以固定为经验证的版本标签。
# COMPOSE_PROJECT_NAME=yuzu-trial
# APP_IMAGE=yuzu-app:trial-<commit>

# 数据库密码：请改成足够长的随机字符串（例如 openssl rand -base64 24 的结果）
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 首次启动时自动创建的店主账号（仅在数据库里还没有任何员工时生效）
# 密码至少 8 位，需同时包含字母和数字；首次登录后系统会要求修改
INIT_OWNER_USERNAME=owner
INIT_OWNER_PASSWORD=change-me-2026
INIT_OWNER_NAME=店主

# 门店时区与登录有效期（小时）
APP_TIMEZONE=Asia/Shanghai
SESSION_TTL_HOURS=12

# 热表归档（数据库评估，docs/DB_REVIEW_V8147.md 第 5 节）：超过保留天数的挪进 archived_* 表，每小时一次；0 = 不归档这一类，最少 30 天
# ARCHIVE_LOCATION_DAYS=180
# ARCHIVE_INTEGRATION_CALL_DAYS=180
# ARCHIVE_WECOM_PUSH_DAYS=365
# 启动时执行迁移，等表锁的上限（PostgreSQL 时长写法，默认 30s；0 = 不限）
# MIGRATION_LOCK_TIMEOUT=30s

# 智能柜锁（docs/LOCKERS_V8149.md）：none 没接（默认）/ mock 模拟 / http 接门店机上的柜锁桥
# LOCKER_DRIVER=none
# LOCKER_BRIDGE_URL=http://127.0.0.1:9300
# LOCKER_BRIDGE_TOKEN=至少32个字符（openssl rand -hex 32）
# 柜锁能做哪几样（逗号分隔，docs/LOCKERS_V8149.md 第 6、7 节）：open 远程开柜、doors 查柜门、card 发卡器（读写清 M1 手牌）、
# select 自选柜（手机柜：谁占着哪个、远程开、释放）。不写为 open,doors；单机电池锁只有发卡器，写 card；泰格联网锁写 open,doors,card,select
# LOCKER_CAPABILITIES=card
# 退牌后自动释放手机柜（docs/LOCKERS_V8149.md 第 7.4 节）：默认开，写 off 只关掉发起新的自动释放（已有的预留照常核对）；接了 select 才起作用
# LOCKER_AUTO_RELEASE=on
# 柜锁桥接的是哪家店的柜子（docs/LOCKERS_V8149.md 第 7.5 节）：不写为本店 1；别的店登录看不到、用不了
# LOCKER_STORE_ID=1

# 换密钥（docs/BACKEND_REVIEW_V8148.md 第 12 节）：换了新密钥以后，旧的放进这里一段时间（逗号分隔、每把至少 32 位），过了有效期再删
# CANTEEN_CODE_SECRET_PREVIOUS=
# PAYROLL_FILE_KEY_PREVIOUS=
# MALL_API_KEY_PREVIOUS=

# 备份目录：建议指向外置硬盘或另一块磁盘，例如 /Volumes/YuzuBackup/yuzu
BACKUP_DIR=./backups
# 备份服务每隔多少分钟备份一次（5–1440，默认 60）；每份都在临时库里试恢复、自检并记下数据指纹
BACKUP_INTERVAL_MINUTES=60
# 每天这个钟点（0–23，门店时区）之后的第一份记为 daily
BACKUP_HOUR=4
# 每小时的备份（hourly）保留多少小时；daily、升级前、恢复前与手动备份保留多少天
BACKUP_HOURLY_KEEP_HOURS=48
BACKUP_KEEP_DAYS=30
# 备份写外置盘时设为 true，并在备份目录里放一个空文件 .yuzu-backup-target（哨兵）：
# 外置盘没挂载、看不到哨兵时不备份，不往内置盘写
BACKUP_REQUIRE_SENTINEL=false

# 看门狗（scripts/watchdog.sh）告警推送：企业微信群机器人的 Webhook 地址。相当于密码，只写在 .env；不填只写日志
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# ERP 每周一推（8.0.7）：每周一 9:00 把本周应付、待审批、快到期的、逾期应收推到这个群机器人（开关在「经营规则 → 可调的数值」，默认关）。
# 和上面的告警群分开配（告警群里的人不一定该看到应付的金额）；相当于密码，只写在 .env。改了要重启应用
# ERP_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...

# 备份加密用的 age 公钥（age1 开头；私钥只在店主手里，不能写在这里）：OSS 上传与异地副本共用
# AGE_RECIPIENT=age1...
# 异地副本（scripts/offsite-copy.sh，见 Mac mini 部署手册 9.8）：每份备份加密后经 Tailscale 用 SFTP 传到云服务器 A
# OFFSITE_TARGET=yuzubackup@yuzu-test
# OFFSITE_SSH_KEY=~/.ssh/yuzu_offsite
# OFFSITE_PORT=22
# 只传最近多少天的备份（服务器上同样保留 7 天）
# OFFSITE_KEEP_DAYS=7

# 微信小程序（小程序线，docs/MINIPROGRAM.md 第 12 节）：单开的小程序端口，只挂给网关的 /api/mp/*；不设 MP_PORT 就不开。
# 只经 Tailscale 让网关服务器连这个端口，不要做端口转发、不要对公网开放。三个密钥都只写在 .env，不进 GitHub
# MP_PORT=8081
# MP_HOST=0.0.0.0
# 网关的服务密钥：网关那边的 .env 填同一个值（至少 32 个字符，可以用 openssl rand -hex 32 生成）
# MP_GATEWAY_KEY=
# 会员码的签名密钥：只在 yuzu，网关不存（至少 32 个字符）
# MP_CODE_SECRET=

# 员工小程序「汤崎 WCP」（员工小程序线，docs/STAFF_MP.md 第 5、10 节）：单开的员工小程序端口，只挂 /api/staffmp/*；不设 STAFFMP_PORT 就不开。
# 放 Caddy 的服务器把 sys.yuzusystem.xyz/api/staffmp/* 转到这个端口（其余照旧转应用端口；staff.yuzusystem.xyz 不动，照旧是柚子饭堂）。不能与 PORT、MP_PORT、CANTEEN_PORT 相同。
# STAFFMP_PORT=8095
# STAFFMP_HOST=0.0.0.0
# 员工小程序的 AppID 与 AppSecret（小程序后台「开发管理 → 开发设置」）：微信一键登录要用，要么都配、要么都不配；不配只能账号密码登录。
# AppSecret 只写在这里，不进 Git、不进聊天
# STAFFMP_APPID=
# STAFFMP_APP_SECRET=
# 模拟微信（只在 APP_ENV=development / test 认）：code 写 mock-<名字>，不问微信
# STAFFMP_MOCK_WECHAT=true
# 前面的转发服务器的地址（逗号分隔、可写网段）：登录限次按它转来的真实来源 IP 算；不设就不信任转发头
# STAFFMP_TRUST_PROXY=

# 员工食堂 · 柚子饭堂（docs/CANTEEN.md 第 9 节）：单开的员工端口，只挂员工手机用的柚子饭堂与 /api/canteen/*；不设 CANTEEN_PORT 就不开。
# 公网入口是网关服务器上的 Caddy（HTTPS）经 Tailscale 转发到这个端口；备案前在测试服用 tailscale serve 发 https 地址。
# 还要在 ERP「模块设置」里打开「员工食堂」（默认关）。
# CANTEEN_PORT=8090
# CANTEEN_HOST=0.0.0.0
# 饭卡码的密钥（至少 32 个字符，openssl rand -hex 32）：只在 yuzu；换了它，大家要联网打开一次柚子饭堂才能亮码
# CANTEEN_CODE_SECRET=
# 员工端走 HTTPS 时设 true（Cookie 加 Secure）
# CANTEEN_COOKIE_SECURE=true
# 前面的转发服务器的地址（逗号分隔，可写网段）：登录限次按它转来的真实来源 IP 算；不设就不信任转发头
# CANTEEN_TRUST_PROXY=100.64.0.10
# 饭点提醒（网页推送，docs/CANTEEN.md 第 19 节）告诉浏览器推送服务怎么联系管理员（mailto: 或 https: 开头）；不设时用员工打开柚子饭堂的 https 地址。
# 服务器要能往外连 web.push.apple.com（iPhone）；连得上 fcm.googleapis.com 的话安卓 Chrome 也收得到
# CANTEEN_PUSH_CONTACT=mailto:it@example.com

# 国内网络拉取镜像较慢时，可改用镜像源，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
# ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# 短信通道（8.0.4 批量发券的短信通知，docs/MEMBERSHIP_V804.md 第 6 节）：不配时短信留在待发箱，后台「批量发券」能导出名单手动发。
# aliyun：阿里云短信，四项都要配；「券到账」模板要先在阿里云短信控制台申请，模板变量 ${count}、${coupon}、${validTo}。
# mock 只给开发、测试用（不真发，直接记「已发」）；APP_ENV=production 时不认。密钥只放 .env，不要进 Git。
# 用 compose.yaml 部署时这几项由它传进应用容器（改了 .env 要重建容器：docker compose up -d app）。
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_COUPON=

# AI 辅助（8.0.22 起；8.1.1 默认 DeepSeek，店主 2026-11-15 定 MD8；docs/AI_V8022.md 第 4 节）：每天的经营小结、问数、合同条款提示。
# 不配 YUZU_AI_API_KEY 时什么都不发（页面写「还没配置」）。发出去的只有汇总数与打码后的文字；开关在后台「对外接口」→ AI 辅助。
# 密钥只放 .env，不要进 Git、聊天、飞书。用 compose.yaml 部署时这几项由它传进应用容器（改了 .env 要重建容器：docker compose up -d app）。
# DeepSeek 开放平台的 API key（sk- 开头；看着是 Anthropic 的 sk-ant- 密钥不会发给 DeepSeek）
# YUZU_AI_API_KEY=
# 不写就是 deepseek；要用 Claude 写 claude（正式服在大陆连不上，要经代理）
# YUZU_AI_PROVIDER=deepseek
# 模型：默认 deepseek-v4-pro，想省钱可以换 deepseek-flash
# YUZU_AI_MODEL=deepseek-v4-pro
# 地址：默认 https://api.deepseek.com
# YUZU_AI_BASE_URL=https://api.deepseek.com

# ── 工资表原件的加密密钥（OA-17，docs/OA.md 第 20 节）──
# HR 上传的工资表 Excel 原件用它加密存进库（AES-256-GCM）；至少 32 个字符（openssl rand -hex 32）。只放 .env，不进 Git、不进库；
# 换了密钥以后，之前上传的原件解不开（工资条本身不受影响）。正式、试用环境不配就不能上传工资表 Excel（在线编辑照常）
# PAYROLL_FILE_KEY=

# ── 授权的品牌字体（8.1.5，docs/EMENU.md 第 14.2 节）──
# 平板电子菜单的英文用 ABC Arizona Flare（商业字体）：向 Dinamo 买网页授权，把 WOFF2（Regular）改名 en.woff2 放进这个目录，
# 平板刷新页面就换上；没放照旧用 Average Sans 顶替。字体文件不进 Git、不进镜像。Docker 部署默认是 compose.yaml 旁边的 ./brand-fonts
# BRAND_FONT_DIR=./brand-fonts
# 不用 Docker、直接跑 node 时：应用读这个目录（默认是工作目录下的 brand-fonts）
# BRAND_FONT_PATH=./brand-fonts

# 考勤打卡点「搜索地址选点」（docs/OA.md 第 22 节）：配了高德 Web 服务的 key 用高德（国内地址准；坐标换成手机定位的 WGS-84 再存）；
# 不配用 OpenStreetMap（不用 key，国内地址少一些）。GEO_PROVIDER 可指定 amap / osm / off（关掉，只能定位或手输）；mock 只在开发、测试。
# AMAP_WEB_KEY=
# GEO_PROVIDER=

# 采购商城对接（docs/MALL_V8131.md 第 2 节）：商城后端调 /api/erp/mall/* 时在请求头 x-mall-key 里带这个密钥。
# 不对接商城就不要设（不设时商城接口一律拒绝）；至少 32 个字符，可以用 openssl rand -hex 32 生成；商城后端那边填同一个值
# MALL_API_KEY=

# ── 访问与过载保护（src/server/lib/protect.ts）──
# 每个登录会话每分钟最多多少个请求、每个来源地址每分钟最多多少个（超了回 429 RATE_LIMITED，页面稍后自动重试）
# RATE_LIMIT_SESSION_PER_MIN=600
# RATE_LIMIT_IP_PER_MIN=300
# 同时在处理的请求超过这个数、或事件循环延迟超过这么多毫秒时，新的请求先拒绝（503 OVERLOADED，页面稍后重试）；0 = 不查延迟
# OVERLOAD_MAX_INFLIGHT=256
# OVERLOAD_MAX_LAG_MS=1000
# 只有这些地址或网段能用接口（逗号分隔，如 192.168.1.0/24,100.64.0.0/10）；不写 = 不限（店主 2026-11-27：Z5 不做，公网也能上）
# ACCESS_ALLOW_CIDRS=
# 日志详细程度：fatal / error / warn / info / debug（默认 info）
# LOG_LEVEL=info
# 容器的内存上限：数据库、应用各默认 2g；门店机内存小于 8 GB 时可以各调成 1g，大于 16 GB 的不用改
# DB_MEM_LIMIT=2g
# APP_MEM_LIMIT=2g
