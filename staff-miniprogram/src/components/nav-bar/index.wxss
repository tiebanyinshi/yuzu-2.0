.nav {
  background-color: var(--bg);
}
.nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 24rpx;
}
.brand {
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink);
}
.instance {
  margin-left: 16rpx;
  padding: 0 12rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  background-color: var(--warn-soft);
  color: var(--warn);
  font-size: var(--fs-caption);
  font-weight: 600;
}
.instance.prod {
  background-color: var(--surface-2);
  color: var(--ink-2);
}
.instance.small {
  margin-left: 8rpx;
  flex: none;
}
.back {
  display: flex;
  align-items: center;
  min-width: 88rpx;
  padding-right: 16rpx;
  flex: none;
}
.back-icon {
  width: 44rpx;
  height: 44rpx;
}
.back-text {
  margin-left: 4rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}
.title-wrap {
  flex: 1;
  min-width: 0;
  /* 和左边返回按钮一样宽的留白，让标题居中 */
  margin-right: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title {
  max-width: 100%;
  text-align: center;
  font-size: var(--fs-body-l);
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink);
}
/* 版本 + SHA：小字、不抢标题 */
.build {
  margin-left: 16rpx;
  min-width: 0;
  font-size: 20rpx;
  color: var(--ink-3);
}
.build-sub {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--ink-3);
}
.large {
  padding: 16rpx var(--gutter) 8rpx;
}
.large-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}
.large-title {
  font-size: var(--fs-display);
  line-height: 1.2;
  font-weight: 600;
  color: var(--ink);
}
.actions {
  display: flex;
  align-items: center;
}
