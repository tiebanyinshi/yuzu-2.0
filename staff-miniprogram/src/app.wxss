/*
 * 汤崎 WCP · 员工小程序的设计令牌与公共样式（docs/STAFF_MP.md 第 4 节，核对清单第 13.1 节）。
 * 页面只用这里的令牌（变量与类），不在页面里另写颜色、字号。
 *   · 界面 90% 以上是中性色：亚麻米白底、卡片、墨色字与墨色主按钮；木色只做大字、进度与图形，做字的木色用加深的 --wood-text；
 *   · 字号 24 / 28 / 32 / 36 / 40 / 48 rpx（TDesign 的一套），必要信息不小于 28rpx；大字（.large-text）整套放大一档；
 *   · 间距 16 / 24 / 32 / 48 / 64 rpx；圆角 12（按钮、输入框）/ 16（卡片）/ 24（底部弹层）；卡片细线、不加阴影；
 *   · 不用 flex 的 gap（老 iOS 不认），间距用外边距；不写 transition: all。
 */
page {
  --bg: #F5F1EA;
  --surface: #FCFAF6;
  --surface-2: #EFE9DE;
  --line: #E0D7C9;
  --line-strong: #958469;
  --ink: #1C1A17;
  --ink-2: #5F574D;
  --ink-3: #8A8176;
  --on-ink: #FCFAF6;
  --wood: #937051;
  --wood-text: #7A5C41;
  --wood-soft: #EBDECA;
  --success: #3F5E4B;
  --success-soft: #E3EAE2;
  --danger: #A6452F;
  --danger-soft: #F4E1DA;
  --info: #4E6B82;
  --info-soft: #E1E8EE;
  --warn: #8A5A12;
  --warn-soft: #F5E7CC;

  --fs-caption: 24rpx;
  --fs-body: 28rpx;
  --fs-body-l: 32rpx;
  --fs-title-s: 36rpx;
  --fs-title: 40rpx;
  --fs-display: 48rpx;
  --lh-caption: 40rpx;
  --lh-body: 44rpx;
  --lh-body-l: 48rpx;

  --gutter: 32rpx;
  --radius-control: 12rpx;
  --radius-card: 16rpx;
  --radius-sheet: 24rpx;

  --ease: cubic-bezier(0.23, 1, 0.32, 1);
  --font: -apple-system, "PingFang SC", "HarmonyOS Sans SC", "HarmonyOS Sans", "MiSans", "Helvetica Neue", "Microsoft YaHei", sans-serif;

  background-color: var(--bg);
  color: var(--ink);
  font-family: var(--font);
  font-size: var(--fs-body);
  line-height: 1.6;
}

/* 大字（「我的 → 大字」，默认跟着微信的字体大小）：整套放大一档 */
.large-text {
  --fs-caption: 28rpx;
  --fs-body: 32rpx;
  --fs-body-l: 36rpx;
  --fs-title-s: 40rpx;
  --fs-title: 44rpx;
  --fs-display: 52rpx;
  --lh-caption: 44rpx;
  --lh-body: 48rpx;
  --lh-body-l: 54rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg);
  color: var(--ink);
  font-family: var(--font);
  font-size: var(--fs-body);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.gutter {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
}

/* ── 字 ── */
.t-display {
  font-size: var(--fs-display);
  line-height: 1.2;
  font-weight: 600;
}
.t-title {
  font-size: var(--fs-title);
  line-height: 1.25;
  font-weight: 600;
}
.t-title-s {
  font-size: var(--fs-title-s);
  line-height: 1.3;
  font-weight: 600;
}
.t-body-l {
  font-size: var(--fs-body-l);
  line-height: var(--lh-body-l);
}
.t-body {
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}
.t-caption {
  font-size: var(--fs-caption);
  line-height: var(--lh-caption);
  color: var(--ink-2);
}
.muted {
  color: var(--ink-2);
}
.faint {
  color: var(--ink-3);
}
.wood {
  color: var(--wood-text);
}
.strong {
  font-weight: 600;
}
/* 时间、金额、工资条的数字：系统字体的等宽数字 */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}
/* Tab 大标题上方的英文小标题：只在四个 Tab 上用 */
.eyebrow {
  font-size: var(--fs-caption);
  line-height: var(--lh-caption);
  letter-spacing: 0.12em;
  color: var(--wood-text);
  font-weight: 600;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 卡片与分区 ── */
.card {
  background-color: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  box-sizing: border-box;
}
.card-pad {
  padding: 32rpx;
}
.section {
  margin-top: 48rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

/* ── 列表行（≥ 112rpx） ── */
.row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  background-color: var(--surface);
}
.row + .row {
  border-top: 1px solid var(--line);
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-title {
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--ink);
}
.row-sub {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  line-height: var(--lh-caption);
  color: var(--ink-2);
}
.row-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex: none;
}
.chevron {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  flex: none;
  opacity: 0.55;
}

/* ── 按钮：去掉微信按钮的默认样式 ── */
button {
  margin: 0;
  padding: 0;
  background: none;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  text-align: inherit;
}
button::after {
  border: none;
}
.btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  height: 96rpx;
  margin: 0 !important;
  padding: 0 40rpx !important;
  border-radius: var(--radius-control);
  font-size: var(--fs-body-l);
  font-weight: 600 !important;
  line-height: 1;
  box-sizing: border-box;
  transition: transform 160ms var(--ease), opacity 160ms var(--ease);
}
.btn.primary {
  background-color: var(--ink);
  color: var(--on-ink);
}
.btn.secondary {
  background-color: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line-strong);
}
.btn.danger {
  background-color: var(--surface);
  color: var(--danger);
  border: 1px solid var(--danger);
}
.btn.block {
  width: 100% !important;
}
.btn[disabled] {
  opacity: 0.4;
}
/* 文字按钮：次要操作 */
.link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--ink);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
/* 按下：100 毫秒内有反馈，缩到 0.97（hover-stay-time 写 120） */
.pressed {
  transform: scale(0.97);
  opacity: 0.85;
}
.row-pressed {
  background-color: var(--surface-2);
}

/* ── 输入框 ── */
.input {
  height: 96rpx;
  padding: 0 24rpx;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background-color: var(--surface);
  font-size: var(--fs-body-l);
  color: var(--ink);
  box-sizing: border-box;
}
.input-placeholder {
  color: var(--ink-3);
}
.field {
  margin-top: 32rpx;
}
.field-label {
  margin-bottom: 12rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.field-error {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--danger);
}

/* ── 提示条（错误留在原地，写原因和怎么办） ── */
.notice {
  padding: 24rpx 28rpx;
  border-radius: var(--radius-control);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}
.notice.error {
  background-color: var(--danger-soft);
  color: var(--danger);
}
.notice.info {
  background-color: var(--info-soft);
  color: var(--info);
}
.notice.warn {
  background-color: var(--warn-soft);
  color: var(--warn);
}
.notice.success {
  background-color: var(--success-soft);
  color: var(--success);
}

/* ── 标签 ── */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: var(--fs-caption);
  font-weight: 600;
}
.tag.new {
  background-color: var(--wood-soft);
  color: var(--wood-text);
}
.tag.neutral {
  background-color: var(--surface-2);
  color: var(--ink-2);
}

/* ── 骨架：形状与真实内容一致 ── */
.skeleton {
  background-color: var(--surface-2);
  border-radius: 8rpx;
}
.skeleton-line {
  height: 28rpx;
  margin-top: 16rpx;
  background-color: var(--surface-2);
  border-radius: 6rpx;
}

/* ── 进场：淡入 200 毫秒（只动透明度与位移） ── */
.fade-in {
  animation: fade-in 200ms var(--ease) both;
}
@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
