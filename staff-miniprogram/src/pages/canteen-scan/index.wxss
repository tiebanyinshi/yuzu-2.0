.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}
.count {
  color: var(--wood-text);
}
.viewfinder {
  overflow: hidden;
}
.camera {
  width: 100%;
  height: 480rpx;
}
.camera-off {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 480rpx;
  padding: 0 48rpx;
  text-align: center;
}
.camera-off .btn {
  margin-top: 24rpx;
}
.tip {
  margin: 16rpx 0 24rpx;
}
.result.ok .row-title {
  color: var(--success);
}
.result.bad .row-title {
  color: var(--danger);
}
.result.wait .row-title {
  color: var(--warn);
}
.undo {
  flex: none;
  margin-left: 16rpx;
}
.search-row {
  display: flex;
  align-items: center;
}
.search {
  flex: 1;
  margin-right: 16rpx;
}
.people {
  margin-top: 24rpx;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--surface-2);
  color: var(--ink-2);
  line-height: 64rpx;
  text-align: center;
  flex: none;
  margin-right: 24rpx;
}
.voided {
  color: var(--ink-3);
  text-decoration: line-through;
}
.btn.small {
  flex: none;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: var(--fs-body);
}
