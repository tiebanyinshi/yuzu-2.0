.profile {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: var(--ink);
  color: var(--on-ink);
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 112rpx;
  text-align: center;
  flex: none;
}
.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 32rpx;
}
.list {
  overflow: hidden;
}
.row-action {
  min-width: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: right;
  font-weight: 600;
  color: var(--danger);
}
.hint {
  margin-top: 16rpx;
}
.logout {
  margin-top: 64rpx !important;
}
