.profile {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: var(--ink);
  color: var(--on-ink);
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 112rpx;
  text-align: center;
  flex: none;
}
.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 32rpx;
}
.list {
  overflow: hidden;
}
.row-action {
  min-width: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: right;
  font-weight: 600;
  color: var(--danger);
}
.hint {
  margin-top: 16rpx;
}
.logout {
  margin-top: 64rpx !important;
}

.level-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.level-title {
  font-size: var(--fs-title-s);
  font-weight: 600;
  color: var(--wood-text);
}
.level-credits {
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.bar {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  background-color: var(--surface-2);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background-color: var(--wood);
}
.level-sub {
  margin-top: 12rpx;
}
