.line {
  margin: 8rpx 0 24rpx;
}
.empty {
  margin-bottom: 24rpx;
}
.qa {
  margin-bottom: 24rpx;
}
.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-card);
  background-color: var(--surface);
  border: 1px solid var(--line);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  white-space: pre-wrap;
}
.bubble.mine {
  margin: 0 0 12rpx auto;
  background-color: var(--wood-soft);
  border-color: var(--wood-soft);
}
.bubble.pending {
  color: var(--ink-2);
}
.src {
  margin-top: 12rpx;
}
.ask {
  margin-top: 16rpx;
}
.input {
  width: 100%;
  min-height: 120rpx;
  margin-bottom: 20rpx;
  font-size: var(--fs-body);
}
