<view class="page {{large ? 'large-text' : ''}}">
  <nav-bar title="{{title}}" />
  <state-view wx:if="{{state !== 'ready'}}" state="{{state}}" message="{{error}}" bindretry="onRetry" />
  <view wx:else class="gutter">
    <view class="t-caption line">{{line}} · 柚子只按这门课的课件回答，课件里没有的会请你问主管或带教师傅</view>
    <view wx:if="{{!rows.length}}" class="t-body muted empty">还没问过。例如：「客人喝了酒能泡汤吗？」</view>
    <view wx:for="{{rows}}" wx:key="id" class="qa">
      <view class="bubble mine">{{item.question}}</view>
      <view class="bubble {{item.status === 'done' ? '' : 'pending'}}">
        <text user-select>{{item.answer}}</text>
        <view wx:if="{{item.sources}}" class="t-caption src">{{item.sources}}</view>
      </view>
    </view>
    <view wx:if="{{notice}}" class="notice {{noticeTone}}">{{notice}}</view>
    <view wx:if="{{!off}}" class="ask card card-pad">
      <textarea class="input" value="{{question}}" maxlength="300" auto-height placeholder="写下你的问题（最多 300 字）" placeholder-class="input-placeholder" bindinput="onInput" disabled="{{busy || waiting}}" aria-label="问题" />
      <button class="btn primary" hover-class="pressed" hover-stay-time="120" disabled="{{busy || waiting || !question}}" bindtap="onAsk">{{busy || waiting ? '柚子在想……' : '问柚子'}}</button>
    </view>
  </view>
</view>
