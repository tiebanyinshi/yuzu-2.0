.meal {
  margin-bottom: 24rpx;
}
.meal-head {
  padding: 28rpx 32rpx 8rpx;
}
.meal-note {
  margin-top: 4rpx;
}
.dish {
  align-items: center;
}
.emoji {
  width: 64rpx;
  font-size: 40rpx;
  line-height: 64rpx;
  text-align: center;
  flex: none;
  margin-right: 20rpx;
}
.like {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 88rpx;
  padding: 0 16rpx;
  margin-right: -16rpx;
  color: var(--ink-3);
  flex: none;
}
.like.on {
  color: var(--danger);
}
.heart {
  font-size: 36rpx;
}
.count {
  margin-left: 8rpx;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}
.foot {
  margin: 16rpx 0 48rpx;
}
