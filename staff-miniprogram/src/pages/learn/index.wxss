.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background-color: var(--surface);
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}
.search-text {
  font-size: var(--fs-body);
  color: var(--ink-3);
}
.list {
  overflow: hidden;
}
.level {
  padding: 28rpx 28rpx 24rpx;
}
.level-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.level-title {
  font-size: var(--fs-title-s);
  font-weight: 600;
  color: var(--wood-text);
}
.level-credits {
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.bar {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  background-color: var(--surface-2);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background-color: var(--wood);
}
.level-sub {
  margin-top: 12rpx;
}
.resume {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
}
.eyebrow {
  font-size: var(--fs-caption);
  color: var(--wood-text);
  letter-spacing: 2rpx;
}
.block-gap {
  margin-top: 16rpx;
}
.sub-head {
  margin: 32rpx 0 12rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-2);
}
.overdue {
  color: var(--danger);
}
.tag.late {
  background-color: var(--danger-soft);
  color: var(--danger);
}
