.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background-color: var(--surface);
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}
.search-text {
  font-size: var(--fs-body);
  color: var(--ink-3);
}
.list {
  overflow: hidden;
}
