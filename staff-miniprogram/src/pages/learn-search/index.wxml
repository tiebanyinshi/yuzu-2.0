<view class="page {{large ? 'large-text' : ''}}">
  <nav-bar title="{{academy ? '搜课程与资料' : '搜培训资料'}}" />
  <view class="gutter">
    <view class="search">
      <image class="search-icon" src="/assets/icons/search.png" />
      <input class="search-input" focus value="{{q}}" placeholder="例如：泡汤禁忌、收银、交班" placeholder-class="input-placeholder" confirm-type="search" maxlength="30" bindinput="onInput" bindconfirm="onConfirm" aria-label="{{academy ? '搜课程与资料' : '搜培训资料'}}" />
      <view wx:if="{{q}}" class="clear" hover-class="pressed" hover-stay-time="120" bindtap="onClear" aria-role="button" aria-label="清空">清空</view>
    </view>
  </view>

  <view wx:if="{{state === 'idle'}}" class="gutter section">
    <block wx:if="{{recent.length}}">
      <view class="section-head"><view class="section-title">最近搜过</view></view>
      <view class="chips">
        <view wx:for="{{recent}}" wx:key="*this" class="chip" hover-class="row-pressed" hover-stay-time="120" data-q="{{item}}" bindtap="onRecent" aria-role="button">{{item}}</view>
      </view>
    </block>
    <view wx:else class="t-body muted">{{academy ? '输入课程或资料名字里的字' : '输入资料名字里的字'}}，例如「禁忌」「交班」。</view>
  </view>

  <state-view wx:elif="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'empty' ? '没有搜到' : ''}}" message="{{state === 'empty' ? (academy ? '换个说法试试，或者到课程、知识库里按分类找' : '换个说法试试，或者到知识库里按文件夹找') : error}}" rows="2" bindretry="onRetry" />

  <view wx:else class="gutter section">
    <block wx:if="{{academy}}">
      <view class="section-head"><view class="section-title">课程</view></view>
      <view wx:if="{{coursesFailed}}" class="card list">
        <view class="row" hover-class="row-pressed" hover-stay-time="120" bindtap="onRetry" aria-role="button">
          <view class="row-main">
            <view class="row-title">课程这次没搜成</view>
            <view class="row-sub">点这里再搜一次</view>
          </view>
        </view>
      </view>
      <view wx:elif="{{courses.length}}" class="card list">
        <view wx:for="{{courses}}" wx:key="id" class="row" hover-class="row-pressed" hover-stay-time="120" data-id="{{item.id}}" bindtap="onCourse" aria-role="button">
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view class="row-sub num">{{item.sub}}</view>
          </view>
          <view wx:if="{{item.progress}}" class="tag {{item.done ? 'neutral' : 'new'}}">{{item.progress}}</view>
          <image class="chevron" src="/assets/icons/chevron.png" />
        </view>
      </view>
      <view wx:else class="t-body muted">没有搜到课程</view>
      <view class="section-head"><view class="section-title">资料</view></view>
    </block>
    <view wx:if="{{!results.length}}" class="t-body muted">没有搜到资料</view>
    <view wx:else class="card list">
      <view wx:for="{{results}}" wx:key="id" class="row" hover-class="row-pressed" hover-stay-time="120" data-id="{{item.id}}" data-folder="{{item.folderId}}" bindtap="onFile" aria-role="button">
        <image class="row-icon" src="/assets/icons/{{item.icon}}.png" />
        <view class="row-main">
          <view class="row-title">{{item.title}}</view>
          <view class="row-sub num">{{item.meta}}</view>
        </view>
        <view wx:if="{{item.isNew}}" class="tag new">新</view>
      </view>
    </view>
  </view>
</view>
