.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-top: 16rpx;
  padding: 0 0 0 24rpx;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background-color: var(--surface);
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
  flex: none;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: var(--fs-body-l);
}
.clear {
  min-width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 600;
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  margin: 0 16rpx 16rpx 0;
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: 1px solid var(--line-strong);
  border-radius: 44rpx;
  font-size: var(--fs-body);
  background-color: var(--surface);
}
.list {
  overflow: hidden;
}
