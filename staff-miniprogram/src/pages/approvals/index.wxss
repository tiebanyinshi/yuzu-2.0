.tabs {
  display: flex;
  border-bottom: 1px solid var(--line);
  margin-bottom: 24rpx;
}
.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
  border-bottom: 4rpx solid transparent;
}
.tab.on {
  color: var(--ink);
  font-weight: 600;
  border-bottom-color: var(--ink);
}
.count {
  margin-left: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background-color: var(--danger);
  color: var(--on-ink);
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}
.list-wrap {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.list {
  overflow: hidden;
}
.status {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.status.pending {
  color: var(--info);
}
.status.approved {
  color: var(--success);
}
.status.rejected {
  color: var(--danger);
}
.more {
  margin-top: 16rpx;
  text-align: center;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--gutter) calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--bg);
  border-top: 1px solid var(--line);
}
