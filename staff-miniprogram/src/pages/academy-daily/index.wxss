.head {
  margin: 8rpx 0 16rpx;
}
.qa,
.done {
  padding: 24rpx 28rpx;
}
.eyebrow {
  font-size: var(--fs-caption);
  color: var(--wood-text);
}
.stem {
  margin: 8rpx 0 16rpx;
  font-size: var(--fs-body-l);
  font-weight: 600;
  line-height: 1.5;
}
.opt {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  font-size: var(--fs-body-l);
  line-height: 1.5;
}
.opt.chosen {
  border-color: var(--ink);
  border-width: 2px;
}
.opt.right {
  border-color: var(--success);
  background-color: var(--success-soft);
}
.opt.wrong {
  border-color: var(--danger);
  background-color: var(--danger-soft);
}
.submit,
.answer {
  margin-top: 20rpx !important;
}
.grades {
  margin-top: 20rpx;
}
.grade-tip {
  margin-bottom: 12rpx;
}
.grade-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  grid-gap: 12rpx;
}
.grade {
  padding: 0 !important;
}
.result {
  margin-top: 20rpx;
  font-weight: 600;
}
.result.ok {
  color: var(--success);
}
.result.bad {
  color: var(--danger);
}
.explain {
  margin-top: 12rpx;
}
.notice {
  margin-top: 20rpx;
}
.resend {
  margin-top: 16rpx;
}
.next {
  margin-top: 28rpx !important;
}
.done-title {
  margin-bottom: 8rpx;
  font-size: var(--fs-title-s);
  font-weight: 600;
}
.pending-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
