<view class="page {{large ? 'large-text' : ''}}">
  <nav-bar title="每日一练" />
  <state-view wx:if="{{state !== 'ready'}}" state="{{state}}" message="{{error}}" bindretry="onRetry" />
  <view wx:else class="gutter">
    <block wx:if="{{item}}">
      <view class="t-caption num head">{{head}}</view>
      <view class="card qa">
        <view class="eyebrow">{{item.course}}{{item.isNew ? ' · 新题' : ''}}{{item.multi ? ' · 多选' : ''}}{{item.recall ? ' · 问答卡' : ''}}</view>
        <view class="stem">{{item.stem}}</view>

        <block wx:if="{{item.recall}}">
          <view wx:if="{{showAnswer || answered}}" class="notice info answer">{{answered ? answered.answerText : item.answerText}}</view>
          <button wx:else class="btn secondary block" hover-class="pressed" hover-stay-time="120" bindtap="onShowAnswer">想好了，看答案</button>
          <view wx:if="{{showAnswer && !answered}}" class="grades">
            <view class="t-caption grade-tip">记得怎么样？</view>
            <view class="grade-row">
              <button wx:for="{{grades}}" wx:key="grade" wx:for-item="g" class="btn secondary grade" hover-class="pressed" hover-stay-time="120" disabled="{{busy || unsure}}" data-grade="{{g.grade}}" bindtap="onGrade">{{g.label}}</button>
            </view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{opts}}" wx:key="index" wx:for-item="op" wx:for-index="k" class="opt {{op.chosen ? 'chosen' : ''}} {{op.right ? 'right' : ''}} {{op.wrong ? 'wrong' : ''}}" hover-class="pressed" hover-stay-time="120" data-option="{{k}}" bindtap="onOption" aria-role="button">{{op.text}}</view>
          <button wx:if="{{!answered}}" class="btn primary block submit" hover-class="pressed" hover-stay-time="120" disabled="{{!canSubmit || busy || unsure}}" bindtap="onSubmit">交</button>
        </block>

        <view wx:if="{{answered}}" class="t-body result {{answered.ok === false ? 'bad' : 'ok'}}">{{answered.line}}</view>
        <view wx:if="{{answered && answered.explanation}}" class="t-caption explain">{{answered.explanation}}</view>
      </view>

      <view wx:if="{{notice}}" class="notice {{unsure ? 'warn' : 'error'}}">
        <view>{{notice}}</view>
        <button wx:if="{{unsure}}" class="btn secondary resend" hover-class="pressed" hover-stay-time="120" disabled="{{busy}}" bindtap="onResend">再交一次（同一次作答）</button>
        <view wx:if="{{rejected}}" class="pending-actions">
          <button class="btn secondary" hover-class="pressed" hover-stay-time="120" bindtap="onSkip">跳过这一题</button>
          <button class="btn secondary" hover-class="pressed" hover-stay-time="120" bindtap="onReload">刷新再练</button>
        </view>
      </view>
      <button wx:if="{{answered}}" class="btn primary block next" hover-class="pressed" hover-stay-time="120" bindtap="onNext">{{idx + 1 < total ? '下一题' : '做完了'}}</button>
    </block>

    <view wx:else class="card done">
      <view class="done-title">{{total ? '今天的题做完了' : '今天没有要练的题'}}</view>
      <view class="t-body muted">{{finished}}</view>
      <view wx:if="{{!total}}" class="t-caption">学过的课里有题以后，这里每天会出该复习的题</view>
      <button class="btn secondary block next" hover-class="pressed" hover-stay-time="120" bindtap="onBack">回到学习</button>
    </view>
  </view>
</view>
