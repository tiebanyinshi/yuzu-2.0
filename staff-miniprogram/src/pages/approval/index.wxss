.head {
  padding-top: 16rpx;
}
.head-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.status {
  margin-right: 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-2);
}
.status.pending {
  color: var(--info);
}
.status.approved {
  color: var(--success);
}
.status.rejected {
  color: var(--danger);
}
.list {
  overflow: hidden;
}
.kv {
  display: flex;
  padding: 24rpx 32rpx;
  background-color: var(--surface);
}
.kv + .kv {
  border-top: 1px solid var(--line);
}
.k {
  width: 180rpx;
  flex: none;
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.v {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
}
.files {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 16rpx;
}
.thumb {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-control);
  background-color: var(--surface-2);
}
.file-name {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  word-break: break-all;
  text-align: center;
}
.step {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.step.pending {
  color: var(--info);
}
.step.approved {
  color: var(--success);
}
.step.rejected {
  color: var(--danger);
}
.event {
  padding: 12rpx 0;
}
.pending-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.area {
  width: 100%;
  height: 176rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.act-btn {
  margin-top: 24rpx !important;
}
.own {
  display: flex;
  justify-content: space-between;
}
.danger-link {
  color: var(--danger);
}
