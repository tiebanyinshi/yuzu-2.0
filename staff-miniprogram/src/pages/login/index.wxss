.hero {
  padding-top: calc(env(safe-area-inset-top) + 160rpx);
  padding-bottom: 48rpx;
}
.brand {
  font-size: 64rpx;
  line-height: 1.15;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.01em;
}
.hero-sub {
  margin-top: 16rpx;
}
.instance {
  display: inline-block;
  margin-top: 24rpx;
  padding: 0 12rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  background-color: var(--warn-soft);
  color: var(--warn);
  font-size: var(--fs-caption);
  font-weight: 600;
}
.skeleton.block {
  height: 480rpx;
  border-radius: var(--radius-card);
}
.retry {
  margin-top: 32rpx !important;
}
.divider {
  margin: 40rpx 0 8rpx;
  text-align: center;
}
.password-row {
  display: flex;
  align-items: center;
}
.password-input {
  flex: 1;
  min-width: 0;
}
.eye {
  margin-left: 16rpx;
  min-width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 600;
  color: var(--ink);
}
.check {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  padding: 16rpx 0;
  min-height: 88rpx;
}
.box {
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  margin-right: 20rpx;
  border: 1px solid var(--line-strong);
  border-radius: 8rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: var(--on-ink);
  flex: none;
}
.box.on {
  background-color: var(--ink);
  border-color: var(--ink);
}
.check-text {
  flex: 1;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}
.error-box {
  margin-top: 32rpx;
}
.submit {
  margin-top: 48rpx !important;
}
.legal {
  margin-top: 24rpx;
  text-align: center;
}
.link-inline {
  color: var(--ink);
  text-decoration: underline;
}
.foot {
  margin-top: 96rpx;
  text-align: center;
}
