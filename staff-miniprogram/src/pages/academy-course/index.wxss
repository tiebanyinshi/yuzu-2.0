.head {
  margin: 8rpx 0 24rpx;
}
.title {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.3;
}
.summary {
  margin: 12rpx 0;
}
.list {
  overflow: hidden;
}

.block-gap {
  margin-top: 16rpx;
}
.stars {
  display: flex;
  margin-bottom: 16rpx;
}
.star {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 52rpx;
  color: var(--line-strong);
}
.star.on {
  color: var(--wood);
}
.input {
  width: 100%;
  min-height: 96rpx;
  margin-bottom: 16rpx;
  font-size: var(--fs-body);
}
