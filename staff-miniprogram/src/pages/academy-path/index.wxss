.head {
  margin: 8rpx 0 24rpx;
}
.title {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.3;
}
.summary {
  margin: 12rpx 0;
}
.stages {
  padding-left: 8rpx;
  border-left: 2rpx solid var(--line);
  margin-left: 24rpx;
}
.stage {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dot {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-left: -34rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line-strong);
  background-color: var(--surface);
  font-size: var(--fs-caption);
  line-height: 44rpx;
  text-align: center;
  color: var(--ink-2);
}
.dot.done {
  border-color: var(--wood);
  background-color: var(--wood);
  color: var(--on-ink);
}
.stage-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}
