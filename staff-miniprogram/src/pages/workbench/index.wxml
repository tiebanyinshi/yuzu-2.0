<view class="page {{large ? 'large-text' : ''}}">
  <nav-bar large title="工作台" eyebrow="WORKBENCH" />
  <view class="gutter">
    <view class="search">
      <image class="search-icon" src="/assets/icons/search.png" />
      <input class="search-input" value="{{keyword}}" placeholder="找功能，例如：工资、请假" placeholder-class="input-placeholder" maxlength="20" bindinput="onKeyword" aria-label="找功能" />
      <view wx:if="{{keyword}}" class="clear" hover-class="pressed" hover-stay-time="120" bindtap="onClear" aria-role="button" aria-label="清空">清空</view>
    </view>
  </view>

  <view wx:if="{{!groups.length}}" class="gutter section t-body muted">{{keyword ? '没有叫「' + keyword + '」的功能' : '能用的功能会出现在这里'}}</view>

  <view wx:for="{{groups}}" wx:for-item="g" wx:key="group" class="gutter section">
    <view class="section-head"><view class="section-title">{{g.label}}</view></view>
    <view class="grid card">
      <view wx:for="{{g.entries}}" wx:key="key" class="cell" hover-class="row-pressed" hover-stay-time="120" data-page="{{item.page}}" bindtap="onEntry" aria-role="button" aria-label="{{item.label}}">
        <image class="cell-icon" src="/assets/icons/{{item.icon}}.png" />
        <view class="cell-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
